{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@db": ["packages/db/index.ts"],
      "@db/*": ["packages/db/*"],
      "@core/*": ["packages/core/src/*"],
      "@ai/*": ["packages/ai/*"]
    }
  }
}
